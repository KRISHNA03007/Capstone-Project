  "instructions": {
    "example_question_sqls": [
      {
        "id": "01f1cfd38d0518228fa4dfaede3a2af7",
        "question": [
          "Which products have the highest return rates?"
        ],
        "sql": [
          "SELECT p.product_name, p.brand_name, p.category_name, SUM(r.return_quantity) AS total_returned, SUM(s.sales_quantity) AS total_sold, ROUND(SUM(r.return_quantity) * 100.0 / SUM(s.sales_quantity), 2) AS return_rate_pct FROM mavenmarket.gold.fact_sales s JOIN mavenmarket.gold.dim_product p ON s.product_sk = p.product_sk JOIN mavenmarket.gold.fact_returns r ON p.product_sk = r.product_sk WHERE p.product_name IS NOT NULL GROUP BY p.product_name, p.brand_name, p.category_name HAVING SUM(s.sales_quantity) > 0 ORDER BY return_rate_pct DESC LIMIT 20;"
        ]
      },
      {
        "id": "01f1cfd39d8310b6ad086897826ca8be",
        "question": [
          "Which products have the highest profit margins?"
        ],
        "sql": [
          "SELECT p.product_name, p.category_name, SUM(s.gross_revenue_amount) AS total_revenue, SUM(s.gross_profit_amount) AS total_profit, ROUND(SUM(s.gross_profit_amount) * 100.0 / SUM(s.gross_revenue_amount), 2) AS margin_pct FROM mavenmarket.gold.fact_sales s JOIN mavenmarket.gold.dim_product p ON s.product_sk = p.product_sk GROUP BY p.product_name, p.category_name HAVING SUM(s.gross_revenue_amount) > 1000 ORDER BY margin_pct DESC LIMIT 20;"
        ]
      },
      {
        "id": "01f1cfd3b03d13c8866bbca9cfa5da20",
        "question": [
          "How are stores performing by profitability?"
        ],
        "sql": [
          "SELECT st.store_name, st.city_name, st.store_type_description, SUM(s.sales_quantity) AS total_items_sold, SUM(s.gross_revenue_amount) AS total_revenue, ROUND(SUM(s.gross_profit_amount) * 100.0 / SUM(s.gross_revenue_amount), 2) AS profit_margin_pct FROM mavenmarket.gold.fact_sales s JOIN mavenmarket.gold.dim_store st ON s.store_sk = st.store_sk GROUP BY st.store_name, st.city_name, st.store_type_description HAVING SUM(s.gross_revenue_amount) > 0 ORDER BY total_revenue DESC LIMIT 20;"
        ]
      },
      {
        "id": "01f1cfd3ccc51448b364c9f4ba9c268b",
        "question": [
          "What is the revenue distribution by sales region?"
        ],
        "sql": [
          "SELECT r.sales_region_name, r.sales_district_name, SUM(s.gross_revenue_amount) AS regional_revenue, SUM(s.gross_profit_amount) AS regional_profit, ROUND(SUM(s.gross_profit_amount) * 100.0 / SUM(s.gross_revenue_amount), 2) AS regional_margin_pct FROM mavenmarket.gold.fact_sales s JOIN mavenmarket.gold.dim_store st ON s.store_sk = st.store_sk JOIN mavenmarket.gold.dim_region r ON st.region_sk = r.region_sk GROUP BY r.sales_region_name, r.sales_district_name HAVING SUM(s.gross_revenue_amount) > 0 ORDER BY regional_revenue DESC LIMIT 20;"
        ]
      },
      {
        "id": "01f1cfd3dc761a6b9cd1527c1b828a1b",
        "question": [
          "How effective are our promotions?"
        ],
        "sql": [
          "SELECT pr.promotion_name, pr.promotion_type, SUM(s.sales_quantity) AS promo_items_sold, SUM(s.gross_revenue_amount) AS promo_revenue, ROUND(SUM(s.gross_profit_amount) * 100.0 / SUM(s.gross_revenue_amount), 2) AS promo_margin_pct FROM mavenmarket.gold.fact_sales s JOIN mavenmarket.gold.dim_promotion pr ON s.promotion_sk = pr.promotion_sk WHERE pr.promotion_name != 'No Discount' GROUP BY pr.promotion_name, pr.promotion_type HAVING SUM(s.gross_revenue_amount) > 0 ORDER BY promo_revenue DESC LIMIT 20;"
        ]
      },
      {
        "id": "01f1cfd3ed1c16c3acd956e1f6774a09",
        "question": [
          "How many unique customers do we have?"
        ],
        "sql": [
          "SELECT COUNT(DISTINCT customer_id) AS total_unique_customers FROM mavenmarket.gold.dim_customer HAVING COUNT(DISTINCT customer_id) > 0;"
        ]
      },
      {
        "id": "01f1cfd3fcf71bf4bc4e40afbcd0c2c2",
        "question": [
          "Show the top 10 products by revenue."
        ],
        "sql": [
          "SELECT p.product_name, p.brand_name, p.category_name, SUM(s.gross_revenue_amount) AS total_revenue FROM mavenmarket.gold.fact_sales s JOIN mavenmarket.gold.dim_product p ON s.product_sk = p.product_sk WHERE p.product_name IS NOT NULL GROUP BY p.product_name, p.brand_name, p.category_name HAVING SUM(s.gross_revenue_amount) > 0 ORDER BY total_revenue DESC LIMIT 10;"
        ]
      }
    ],
    "text_instructions": [
      {
        "content": [
          "* **Revenue (Net Sales)** is calculated as Gross Sales minus Discount.\r\n",
          "* **Gross Profit** is calculated as Revenue minus Cost.\r\n",
          "* **Margin %** is calculated as (Gross Profit / Revenue). Always format as a percentage.\r\n",
          "* **Return Rate %** is calculated as Total Items Returned divided by Total Items Sold.\r\n",
          "* When a user asks for \"Top Stores\" or \"Top Products\", rank them by Revenue in descending order.\r\n",
          "* \"Regions\" refers to the region_name column in the Region dimension table."
        ],
        "id": "01f1cebfbf731e6c8876bc66274b69a0"
      }
    ]
  },
  "version": 2
}
