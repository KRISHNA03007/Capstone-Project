{
  "benchmarks": {
    "questions": [
      {
        "answer": [
          {
            "content": [
              "SELECT\r\n",
              "  st.store_name,\r\n",
              "  SUM(r.return_quantity) AS total_returned,\r\n",
              "  SUM(s.sales_quantity) AS total_sold,\r\n",
              "  ROUND(SUM(r.return_quantity) * 100.0 / SUM(s.sales_quantity), 2) AS return_rate_pct\r\n",
              "FROM\r\n",
              "  mavenmarket.gold.fact_sales s\r\n",
              "JOIN\r\n",
              "  mavenmarket.gold.fact_returns r ON s.store_sk = r.store_sk\r\n",
              "JOIN\r\n",
              "  mavenmarket.gold.dim_store st ON s.store_sk = st.store_sk\r\n",
              "GROUP BY\r\n",
              "  st.store_name\r\n",
              "ORDER BY\r\n",
              "  return_rate_pct DESC\r\n",
              "LIMIT 20;"
            ],
            "format": "SQL"
          }
        ],
        "id": "01f1cfd2d8d11a19ba8204f7887a57bf",
        "question": [
          "What is the return rate by store?"
        ]
      },
      {
        "answer": [
          {
            "content": [
              "SELECT\r\n",
              "  SUM(restock_quantity) AS total_restock_quantity\r\n",
              "FROM\r\n",
              "  mavenmarket.gold.fact_inventory\r\n",
              "HAVING\r\n",
              "  SUM(restock_quantity) IS NOT NULL;"
            ],
            "format": "SQL"
          }
        ],
        "id": "01f1cfd2a29810658b058e3a934cee92",
        "question": [
          "What is the total restock quantity for inventory? "
        ]
      },
      {
        "answer": [
          {
            "content": [
              "SELECT\r\n",
              "  ROUND(\r\n",
              "    (SELECT SUM(return_quantity) FROM mavenmarket.gold.fact_returns) * 100.0 / \r\n",
              "    (SELECT SUM(sales_quantity) FROM mavenmarket.gold.fact_sales), 2\r\n",
              "  ) AS overall_return_rate_pct;"
            ],
            "format": "SQL"
          }
        ],
        "id": "01f1cfd25bd8183ca240d7140b9fa10e",
        "question": [
          "What is the overall return rate percentage?"
        ]
      },
      {
        "answer": [
          {
            "content": [
              "SELECT\r\n",
              "  d.year_number,\r\n",
              "  SUM(s.gross_revenue_amount) AS total_revenue\r\n",
              "FROM\r\n",
              "  mavenmarket.gold.fact_sales s\r\n",
              "JOIN\r\n",
              "  mavenmarket.gold.dim_date d ON s.transaction_date_sk = d.date_sk\r\n",
              "WHERE\r\n",
              "  d.year_number IS NOT NULL\r\n",
              "GROUP BY\r\n",
              "  d.year_number\r\n",
              "HAVING\r\n",
              "  SUM(s.gross_revenue_amount) > 0\r\n",
              "ORDER BY\r\n",
              "  d.year_number DESC;"
            ],
            "format": "SQL"
          }
        ],
        "id": "01f1cfd22b6b1a45b6df633949b85ec3",
        "question": [
          "What is our year-over-year revenue growth? "
        ]
      },
      {
        "answer": [
          {
            "content": [
              "SELECT\r\n",
              "  p.product_name,\r\n",
              "  p.brand_name,\r\n",
              "  p.category_name,\r\n",
              "  SUM(r.return_quantity) AS total_returned\r\n",
              "FROM\r\n",
              "  mavenmarket.gold.fact_returns r\r\n",
              "JOIN\r\n",
              "  mavenmarket.gold.dim_product p ON r.product_sk = p.product_sk\r\n",
              "WHERE\r\n",
              "  p.product_name IS NOT NULL\r\n",
              "GROUP BY\r\n",
              "  p.product_name,\r\n",
              "  p.brand_name,\r\n",
              "  p.category_name\r\n",
              "HAVING\r\n",
              "  SUM(r.return_quantity) > 0\r\n",
              "ORDER BY\r\n",
              "  total_returned DESC\r\n",
              "LIMIT 20;"
            ],
            "format": "SQL"
          }
        ],
        "id": "01f1cfd1fb6e1d3683e5d20ab6cbb1d1",
        "question": [
          "Which products have the highest return quantities?"
        ]
      },
      {
        "answer": [
          {
            "content": [
              "SELECT\n",
              "  COUNT(DISTINCT customer_id) AS total_unique_customers\n",
              "FROM\n",
              "  mavenmarket.gold.dim_customer\n",
              "HAVING\n",
              "  COUNT(DISTINCT customer_id) > 0"
            ],
            "format": "SQL"
          }
        ],
        "id": "01f1ced19bb81855b9c035671e4a5a6e",
        "question": [
          "How many unique customers do we have?"
        ]
      },
      {
        "answer": [
          {
            "content": [
              "SELECT\n",
              "  r.sales_region_name,\n",
              "  SUM(s.gross_revenue_amount) AS total_revenue\n",
              "FROM\n",
              "  mavenmarket.gold.fact_sales s\n",
              "JOIN\n",
              "  mavenmarket.gold.dim_store st ON s.store_sk = st.store_sk\n",
              "JOIN\n",
              "  mavenmarket.gold.dim_region r ON st.region_sk = r.region_sk\n",
              "WHERE\n",
              "  r.sales_region_name IS NOT NULL\n",
              "GROUP BY\n",
              "  r.sales_region_name\n",
              "HAVING\n",
              "  SUM(s.gross_revenue_amount) > 0\n",
              "ORDER BY\n",
              "  total_revenue DESC;"
            ],
            "format": "SQL"
          }
        ],
        "id": "01f1ced1819d18fc94e9b5fc1568936d",
        "question": [
          "What is the revenue broken down by region?"
        ]
      },
      {
        "answer": [
          {
            "content": [
              "SELECT\n",
              "  SUM(gross_profit_amount) AS total_gross_profit\n",
              "FROM\n",
              "  mavenmarket.gold.fact_sales\n",
              "HAVING\n",
              "  SUM(gross_profit_amount) IS NOT NULL;"
            ],
            "format": "SQL"
          }
        ],
        "id": "01f1ced15ff11136b34c2c6ff9f05a99",
        "question": [
          "What is the overall gross profit?"
        ]
      },
      {
        "answer": [
          {
            "content": [
              "SELECT\n",
              "  ROUND(SUM(gross_profit_amount) * 100.0 / SUM(gross_revenue_amount), 2) AS profit_margin_pct\n",
              "FROM\n",
              "  mavenmarket.gold.fact_sales\n",
              "HAVING\n",
              "  SUM(gross_revenue_amount) > 0;"
            ],
            "format": "SQL"
          }
        ],
        "id": "01f1ced0fb1c1459bbb5e5e6ec8a2b8e",
        "question": [
          "What is our profit margin percentage?"
        ]
      },
      {
        "answer": [
          {
            "content": [
              "SELECT\n",
              "  SUM(gross_revenue_amount) AS total_revenue\n",
              "FROM\n",
              "  mavenmarket.gold.fact_sales\n",
              "HAVING\n",
              "  SUM(gross_revenue_amount) > 0;"
            ],
            "format": "SQL"
          }
        ],
        "id": "01f1ced049da18b989b6234e820d18e0",
        "question": [
          "What is our total revenue?"
        ]
      }
    ]
  },
