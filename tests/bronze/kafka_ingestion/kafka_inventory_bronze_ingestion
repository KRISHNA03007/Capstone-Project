import pytest
from pyspark.sql.functions import expr

def test_kafka_ingestion_schema_and_transformation(spark):
    """
    Unit test for Kafka bronze ingestion:
    1. Creates fake raw Kafka DataFrame structure (simulating spark.readStream).
    2. Applies the selectExpr transformation from the Databricks notebook.
    3. Asserts row count and verifies required target bronze columns exist.
    """
    # 1. Create fake raw Kafka streaming data (simulating Kafka metadata & value)
    columns = ["key", "value", "topic", "partition", "offset", "timestamp"]
    test_data = [
        (
            b"key1",
            b'{"inventory_id": 101, "item_name": "Widget A", "quantity": 50}',
            "inventory_topic",
            0,
            1001,
            "2026-10-23 12:00:00"
        ),
        (
            b"key2",
            b'{"inventory_id": 102, "item_name": "Widget B", "quantity": 25}',
            "inventory_topic",
            1,
            1002,
            "2026-10-23 12:05:00"
        )
    ]
    
    df_kafka_raw = spark.createDataFrame(test_data, columns)

    # 2. Apply the exact bronze transformation logic from the ingestion notebook
    df_bronze_inventory = df_kafka_raw.selectExpr(
        "CAST(value AS STRING) AS message_payload",
        "topic",
        "partition",
        "offset",
        "timestamp AS event_timestamp"
    )

    # 3. Asserts to verify ingestion transformation success
    # Verify the fake rows loaded correctly through the transformation
    assert df_bronze_inventory.count() == 2

    # Verify all expected bronze output columns exist
    expected_columns = [
        "message_payload",
        "topic",
        "partition",
        "offset",
        "event_timestamp"
    ]
    for col_name in expected_columns:
        assert col_name in df_bronze_inventory.columns
