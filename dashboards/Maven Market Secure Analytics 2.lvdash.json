{
  "datasets": [
    {
      "name": "6b91fb08",
      "displayName": "User Access and Region Overview",
      "queryLines": [
        "SELECT current_user() AS viewer,\n",
        "       CASE WHEN is_member('maven_dataengineer') THEN 'Data Engineer (full access)'\n",
        "            WHEN is_member('maven_executives')   THEN 'Executive (all regions, profit visible)'\n",
        "            WHEN is_member('maven_analysts')     THEN 'Analyst (all regions, profit hidden)'\n",
        "            WHEN is_member('maven_regional_managers') THEN 'Regional Manager (own region only)'\n",
        "            ELSE 'No persona' END AS persona,\n",
        "       CASE WHEN is_member('maven_central_west') THEN 'Central West'\n",
        "            WHEN is_member('maven_mexico_west')  THEN 'Mexico West'\n",
        "            WHEN is_member('maven_dataengineer')\n",
        "              OR is_member('maven_executives')\n",
        "              OR is_member('maven_analysts')     THEN 'All regions'\n",
        "            ELSE 'None' END AS region_scope"
      ]
    },
    {
      "name": "b3eb2803",
      "displayName": "Untitled dataset",
      "queryLines": [
        ""
      ]
    },
    {
      "name": "1edf4b98",
      "displayName": "viewer_info",
      "queryLines": [
        "SELECT current_user() AS viewer,\n",
        "       CASE WHEN is_account_group_member('maven_dataengineer') THEN 'Data Engineer (full access)'\n",
        "            WHEN is_account_group_member('maven_executives')   THEN 'Executive (all regions, profit visible)'\n",
        "            WHEN is_account_group_member('maven_analysts')     THEN 'Analyst (all regions, profit hidden)'\n",
        "            WHEN is_account_group_member('maven_regional_managers') THEN 'Regional Manager (own region only)'\n",
        "            ELSE 'No persona' END AS persona,\n",
        "       CASE WHEN is_account_group_member('maven_central_west') THEN 'Central West'\n",
        "            WHEN is_account_group_member('maven_mexico_west')  THEN 'Mexico West'\n",
        "            WHEN is_account_group_member('maven_dataengineer')\n",
        "              OR is_account_group_member('maven_executives')\n",
        "              OR is_account_group_member('maven_analysts')     THEN 'All regions'\n",
        "            ELSE 'None' END AS region_scope"
      ]
    },
    {
      "name": "efa5db33",
      "displayName": "kpi_summary",
      "queryLines": [
        "SELECT SUM(gross_revenue_amount) AS revenue,\n",
        "       SUM(sales_quantity) AS units_sold,\n",
        "       SUM(gross_profit_amount) AS profit,\n",
        "       COUNT(DISTINCT store_id) AS stores\n",
        "FROM mavenmarket.gold.v_sales_secure"
      ]
    },
    {
      "name": "2e8b4283",
      "displayName": "revenue_by_month",
      "queryLines": [
        "SELECT year_month_code,\n",
        "       SUM(gross_revenue_amount) AS revenue,\n",
        "       SUM(gross_profit_amount) AS profit\n",
        "FROM mavenmarket.gold.v_sales_secure\n",
        "GROUP BY year_month_code\n",
        "ORDER BY year_month_code"
      ]
    },
    {
      "name": "7dc15ec2",
      "displayName": "revenue_by_region",
      "queryLines": [
        "SELECT sales_region,\n",
        "       SUM(gross_revenue_amount) AS revenue,\n",
        "       SUM(gross_profit_amount) AS profit,\n",
        "       SUM(sales_quantity) AS units_sold\n",
        "FROM mavenmarket.gold.v_sales_secure\n",
        "GROUP BY sales_region\n",
        "ORDER BY revenue DESC"
      ]
    },
    {
      "name": "17b0b614",
      "displayName": "top stores",
      "queryLines": [
        "SELECT store_name,\n",
        "       sales_region,\n",
        "       SUM(gross_revenue_amount) AS revenue\n",
        "FROM mavenmarket.gold.v_sales_secure\n",
        "GROUP BY store_name, sales_region\n",
        "ORDER BY revenue DESC\n",
        "LIMIT 15"
      ]
    },
    {
      "name": "b726e9f2",
      "displayName": "Untitled dataset 1",
      "queryLines": [
        ""
      ]
    },
    {
      "name": "2a60323e",
      "displayName": "category_performance",
      "queryLines": [
        "SELECT category_name,\n",
        "       SUM(gross_revenue_amount) AS revenue,\n",
        "       SUM(sales_quantity)       AS units_sold\n",
        "FROM mavenmarket.gold.v_sales_secure\n",
        "GROUP BY category_name\n",
        "ORDER BY revenue DESC"
      ]
    },
    {
      "name": "0eaee8c8",
      "displayName": "returns_by_month",
      "queryLines": [
        "SELECT year_month_code,\n",
        "       SUM(return_quantity) AS units_returned\n",
        "FROM mavenmarket.gold.v_returns_secure\n",
        "GROUP BY year_month_code\n",
        "ORDER BY year_month_code"
      ]
    },
    {
      "name": "a9288535",
      "displayName": "returns_by_region",
      "queryLines": [
        "SELECT sales_region,\n",
        "       SUM(return_quantity) AS units_returned\n",
        "FROM mavenmarket.gold.v_returns_secure\n",
        "GROUP BY sales_region\n",
        "ORDER BY units_returned DESC\n"
      ]
    },
    {
      "name": "bc23b289",
      "displayName": "customer_masked",
      "queryLines": [
        "SELECT customer_id, full_name, birth_date, street_address, city_name,\n",
        "       country_name, occupation_name, yearly_income_range\n",
        "FROM mavenmarket.gold.v_customer_secure\n",
        "WHERE is_current_flag\n",
        "LIMIT 50"
      ]
    }
  ],
