{
  "datasets": [
    {
      "name": "dq_incidents",
      "displayName": "DQ Incidents (Quarantine Checks)",
      "config": {
        "source": "WITH q AS (\n  SELECT 'customers' AS entity, 'mavenmarket.silver.quarantine_customers' AS quarantine_table, CAST(_ingestion_timestamp AS TIMESTAMP) AS detected_at, CAST(_ingestion_timestamp AS DATE) AS record_date, quarantine_reasons FROM mavenmarket.silver.quarantine_customers\n  UNION ALL SELECT 'stores', 'mavenmarket.silver.quarantine_stores', ingested_timestamp, CAST(ingested_timestamp AS DATE), quarantine_reasons FROM mavenmarket.silver.quarantine_stores\n  UNION ALL SELECT 'transactions', 'mavenmarket.silver.quarantine_transactions', ingested_timestamp, CAST(transaction_date AS DATE), quarantine_reasons FROM mavenmarket.silver.quarantine_transactions\n  UNION ALL SELECT 'returns', 'mavenmarket.silver.quarantine_returns', ingested_timestamp, CAST(return_date AS DATE), quarantine_reasons FROM mavenmarket.silver.quarantine_returns\n  UNION ALL SELECT 'inventory', 'mavenmarket.silver.quarantine_inventory', _ingestion_timestamp, CAST(restock_date AS DATE), quarantine_reasons FROM mavenmarket.silver.quarantine_inventory\n  UNION ALL SELECT 'products', 'mavenmarket.silver.quarantine_products', _ingestion_timestamp, CAST(_ingestion_timestamp AS DATE), quarantine_reasons FROM mavenmarket.silver.quarantine_products\n  UNION ALL SELECT 'promotions', 'mavenmarket.silver.quarantine_promotions', ingested_timestamp, CAST(ingested_timestamp AS DATE), quarantine_reasons FROM mavenmarket.silver.quarantine_promotions\n  UNION ALL SELECT 'regions', 'mavenmarket.silver.quarantine_regions', ingested_timestamp, CAST(ingested_timestamp AS DATE), quarantine_reasons FROM mavenmarket.silver.quarantine_regions\n  UNION ALL SELECT 'calendar', 'mavenmarket.silver.quarantine_calendar', _ingestion_timestamp, CAST(_ingestion_timestamp AS DATE), quarantine_reasons FROM mavenmarket.silver.quarantine_calendar\n)\nSELECT entity, quarantine_table, detected_at, record_date, TRIM(chk) AS failed_check\nFROM q LATERAL VIEW EXPLODE(SPLIT(COALESCE(quarantine_reasons, 'Unknown: unspecified'), ';')) t AS chk\nWHERE TRIM(chk) <> '' AND DATE(detected_at) = (SELECT MAX(DATE(detected_at)) FROM (SELECT CAST(_ingestion_timestamp AS DATE) AS detected_at FROM mavenmarket.silver.quarantine_customers UNION ALL SELECT CAST(ingested_timestamp AS DATE) FROM mavenmarket.silver.quarantine_stores UNION ALL SELECT CAST(ingested_timestamp AS DATE) FROM mavenmarket.silver.quarantine_transactions UNION ALL SELECT CAST(ingested_timestamp AS DATE) FROM mavenmarket.silver.quarantine_returns UNION ALL SELECT CAST(_ingestion_timestamp AS DATE) FROM mavenmarket.silver.quarantine_inventory UNION ALL SELECT CAST(_ingestion_timestamp AS DATE) FROM mavenmarket.silver.quarantine_products UNION ALL SELECT CAST(ingested_timestamp AS DATE) FROM mavenmarket.silver.quarantine_promotions UNION ALL SELECT CAST(ingested_timestamp AS DATE) FROM mavenmarket.silver.quarantine_regions UNION ALL SELECT CAST(_ingestion_timestamp AS DATE) FROM mavenmarket.silver.quarantine_calendar))",
        "measures": [
          {
            "name": "failed_checks",
            "displayName": "Failed Checks",
            "expr": "COUNT(1)"
          },
          {
            "name": "affected_sources",
            "displayName": "Affected Sources",
            "expr": "COUNT(DISTINCT entity)"
          },
          {
            "name": "last_detected",
            "displayName": "Last Detected",
            "expr": "MAX(detected_at)"
          },
          {
            "name": "last_record_date",
            "displayName": "Latest Record Date",
            "expr": "MAX(record_date)"
          }
        ],
        "version": "1.1",
        "comment": "Failed hard checks exploded from all silver quarantine tables",
        "dimensions": [
          {
            "expr": "entity",
            "displayName": "Entity"
          },
          {
            "expr": "quarantine_table",
            "displayName": "Quarantine Table"
          },
          {
            "expr": "detected_at",
            "displayName": "Detected At"
          },
          {
            "expr": "record_date",
            "displayName": "Record Date"
          },
          {
            "expr": "failed_check",
            "displayName": "Failed Check"
          },
          {
            "name": "check_category",
            "displayName": "Check Category",
            "expr": "TRIM(SPLIT(failed_check, ':')[0])"
          },
          {
            "name": "record_month",
            "displayName": "Record Month",
            "expr": "DATE_TRUNC('MONTH', record_date)"
          }
        ]
      }
    },
    {
      "name": "dq_scorecard",
      "displayName": "DQ Scorecard Metrics",
      "config": {
        "version": "1.1",
        "source": "SELECT * FROM mavenmarket.silver.dq_metrics\nWHERE run_time = (SELECT MAX(run_time) FROM mavenmarket.silver.dq_metrics)\nQUALIFY ROW_NUMBER() OVER (PARTITION BY table_name ORDER BY run_time DESC) = 1",
        "dimensions": [
          {
            "expr": "table_name",
            "displayName": "Entity"
          },
          {
            "expr": "run_time",
            "displayName": "Run Time"
          },
          {
            "expr": "failure_percentage",
            "displayName": "Failure %"
          },
          {
            "name": "health_status",
            "displayName": "Health Status",
            "expr": "CASE WHEN failure_percentage >= 10 THEN '3 - Critical'\n     WHEN failure_percentage >= 1 OR warn_failed_records > 0 THEN '2 - Elevated'\n     ELSE '1 - Healthy' END"
          }
        ],
        "measures": [
          {
            "name": "records_checked",
            "displayName": "Records Checked",
            "expr": "SUM(records_checked)"
          },
          {
            "name": "hard_failures",
            "displayName": "Hard Failures",
            "expr": "SUM(hard_failed_records)"
          },
          {
            "name": "soft_warnings",
            "displayName": "Soft Warnings",
            "expr": "SUM(warn_failed_records)"
          },
          {
            "name": "quality_score",
            "displayName": "Quality Score",
            "expr": "1 - SUM(hard_failed_records) / NULLIF(SUM(records_checked), 0)",
            "format": {
              "type": "percentage",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "warning_rate",
            "displayName": "Warning Rate",
            "expr": "SUM(warn_failed_records) / NULLIF(SUM(records_checked), 0)",
            "format": {
              "type": "percentage",
              "decimalPlaces": {
                "type": "exact",
                "places": 3.0
              }
            }
          },
          {
            "name": "failing_sources",
            "displayName": "Failing Sources",
            "expr": "COUNT(DISTINCT table_name) FILTER (WHERE hard_failed_records > 0)"
          },
          {
            "name": "entities_monitored",
            "displayName": "Entities Monitored",
            "expr": "COUNT(DISTINCT table_name)"
          }
        ]
      }
    }
  ],
